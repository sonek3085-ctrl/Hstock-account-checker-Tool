# =============================================================
# HSTOCK Account Checker - Environment Variables Template
# Copy this file to .env and fill in your own private values.
# NEVER commit your real .env file or secrets to source control.
# =============================================================

# Server runtime configuration
PORT=3000
NODE_ENV=production

# Public Application URL (used for sharing links and origin references)
APP_URL="https://your-domain.com"

# Optional Email OTP Delivery via Resend (https://resend.com)
# If omitted, verification OTP codes are logged server-side for development.
RESEND_API_KEY=""
EMAIL_FROM="HSTOCK Verification <onboarding@resend.dev>"

# Optional Google Gemini API Key (if enabling AI capabilities)
GEMINI_API_KEY=""

# Optional Meta / Graph API Environment Overrides (Admin panel also stores encrypted/backend settings)
META_APP_ID=""
META_APP_SECRET=""
META_ACCESS_TOKEN=""
