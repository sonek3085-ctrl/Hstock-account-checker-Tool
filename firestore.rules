rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Zero-trust default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'usmanalikhanchandio@gmail.com' ||
        request.auth.token.email == 'usmanchandio079@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && !id.matches('.*[/\\\\.].*');
    }

    // Registered Users (customers can only view/edit own non-privileged profile fields)
    match /users/{userId} {
      allow read: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create: if isValidId(userId) && isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.balance == 0
        && request.resource.data.status == 'active';
      allow update: if isValidId(userId) && (
        isAdmin() ||
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'balance', 'totalDeposited', 'totalSpent', 'status']))
      );
      allow delete: if isAdmin();
    }

    // USDT Deposit Requests
    match /payments/{paymentId} {
      allow read: if isValidId(paymentId) && isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(paymentId) && isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.amountUsd is number
        && request.resource.data.amountUsd >= 1;
      allow update, delete: if isAdmin();
    }

    // Account Checking Batches
    match /batches/{batchId} {
      allow read: if isValidId(batchId) && isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Immutable Wallet Transactions
    match /transactions/{txnId} {
      allow read: if isValidId(txnId) && isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Shared View-Only Reports (point-get allowed for unrevoked links; listing restricted to owner/admin)
    match /shares/{shareId} {
      allow get: if isValidId(shareId) && (resource.data.isRevoked != true || isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid));
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(shareId) && isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isValidId(shareId) && isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Admin-only System Settings & API Keys (never publicly readable)
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
